<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="12dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <!-- 1. ВЕРХНИЙ ИНДИКАТОР КАЛЕНДАРЯ 5/2 (секретное долгое нажатие для врача) -->
    <LinearLayout
        android:id="@+id/layout_calendar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2C2C2E"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_calendar_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ДЕНЬ 1"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_calendar_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Терапия (День 1 из 5 недели)"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. ДВЕ КОЛОНКИ: ОСНОВНОЙ СВЕТОФОР (СЛЕВА) И ПЕШЕХОДНЫЙ СВЕТОФОР БРТ (СПРАВА) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp">

        <!-- ЛЕВАЯ КОЛОНКА: ОСНОВНОЙ УЛИЧНЫЙ СВЕТОФОР (ФАБУЛЫ .FLAC) -->
        <LinearLayout
            android:id="@+id/street_traffic_light_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#121214"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <!-- КРАСНЫЙ СИГНАЛ (#FF0000) (Папка /NeuroPlayer/1_Red/) -->
            <ImageButton
                android:id="@+id/btn_fabula_red"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/shape_traffic_circle_red"
                android:contentDescription="Красная фабула"
                android:elevation="8dp" />

            <!-- ЖЕЛТЫЙ СИГНАЛ (#FFD700) (Папка /NeuroPlayer/2_Yellow/) -->
            <ImageButton
                android:id="@+id/btn_fabula_yellow"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/shape_traffic_circle_yellow"
                android:contentDescription="Желтая фабула"
                android:elevation="8dp" />

            <!-- ЗЕЛЕНЫЙ СИГНАЛ (#00FF00) (Папка /NeuroPlayer/3_Green/) -->
            <ImageButton
                android:id="@+id/btn_fabula_green"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/shape_traffic_circle_green"
                android:contentDescription="Зеленая фабула"
                android:elevation="8dp" />
        </LinearLayout>

        <!-- ПРАВАЯ КОЛОНКА: ПЕШЕХОДНЫЙ СВЕТОФОР (БРТ .MP3) - ОДИНАКОВАЯ ЯРКОСТЬ И СОЧНОСТЬ -->
        <LinearLayout
            android:id="@+id/pedestrian_traffic_light_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#121214"
            android:padding="10dp"
            android:layout_marginStart="6dp">

            <!-- КРАСНЫЙ ПЕШЕХОД (#FF0000) (ЯРКИЙ СОЧНЫЙ СИГНАЛ) -->
            <ImageButton
                android:id="@+id/btn_brt_red"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginVertical="14dp"
                android:background="@drawable/shape_pedestrian_red"
                android:src="@drawable/ic_pedestrian_stop"
                android:contentDescription="БРТ Стоп"
                android:elevation="8dp" />

            <!-- ЗЕЛЕНЫЙ ПЕШЕХОД (#00FF00) (ЯРКИЙ СОЧНЫЙ СИГНАЛ) -->
            <ImageButton
                android:id="@+id/btn_brt_green"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:layout_marginVertical="14dp"
                android:background="@drawable/shape_pedestrian_green"
                android:src="@drawable/ic_pedestrian_walk"
                android:contentDescription="БРТ Поехали"
                android:elevation="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. АККУРАТНАЯ НЕБРОСКАЯ СТРОКА НАЗВАНИЯ ТРЕКА -->
    <TextView
        android:id="@+id/tv_track_title"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:textColor="#E4E4E7"
        android:textSize="14sp"
        android:textStyle="normal"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:alpha="0"
        tools:alpha="1"
        tools:text="Исаев_Речь_01" />

    <!-- 4. НИЖНЯЯ СТРОКА УПРАВЛЕНИЯ С ГОРИЗОНТАЛЬНОЙ ЗЕЛЁНОЙ ПОЛОСОЙ ПРОГРЕССА ПО ВЕРХНЕЙ ГРАНИЦЕ -->
    <FrameLayout
        android:id="@+id/container_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layout_bottom_control_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_bar"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <!-- 1) Левый угол строки: Кнопка/поле таймера -->
            <TextView
                android:id="@+id/tv_playback_timer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/bg_timer_box"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:paddingHorizontal="10dp"
                android:text="⏱ 00:00"
                android:visibility="visible"
                tools:text="⏱ 00:00" />

            <!-- 2) Кнопка СТОП расположена ближе к кнопке таймера -->
            <Button
                android:id="@+id/btn_playback_stop"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_btn_stop"
                android:text="⏹"
                android:textColor="#F87171"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:layout_marginStart="6dp"
                android:enabled="true"
                android:alpha="1.0" />

            <!-- Распорка для смещения кнопок БРТ и Отмена ближе к центру строки -->
            <View
                android:id="@+id/spacer_bottom_left"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="visible" />

            <!-- 3) Кнопка "Брт" (поставлена ближе к центру строки) -->
            <Button
                android:id="@+id/btn_brt_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_btn_green"
                android:text="Брт"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp" />

            <!-- 4) Кнопка "Отмена" (Значок "❌") рядом с кнопкой Брт -->
            <Button
                android:id="@+id/btn_cancel_timer"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon"
                android:text="❌"
                android:textColor="#FF5252"
                android:textSize="16sp" />

            <!-- Правая распорка для центрирования блока БРТ и Отмена -->
            <View
                android:id="@+id/spacer_bottom_right"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Полоса прогресса зелёного цвета горизонтально по верхней границе нижней строки над кнопками -->
        <ProgressBar
            android:id="@+id/pb_playback_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:visibility="visible" />
    </FrameLayout>

</LinearLayout>
